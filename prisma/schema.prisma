generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase PgBouncer, port 6543) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) used by `prisma migrate` / `prisma db push`.
  directUrl = env("DIRECT_URL")
}

model User {
  id String @id @default(cuid())

  /// Clerk user id (`user_…`). Clerk owns identity; this column links the Clerk
  /// user to its local mirror row so the link survives email changes and so
  /// rows created before Clerk (Supabase Auth UUIDs, cuids) keep their id and
  /// all their existing relations. Null until the user first signs in.
  clerkUserId String? @unique @map("clerk_user_id")

  email         String    @unique
  /// DEPRECATED — never read or written by authentication. Clerk owns passwords.
  /// Kept as an empty-string column so no destructive migration is needed; drop
  /// it in a dedicated migration once every environment is confirmed clean.
  password      String    @default("")
  name          String
  role          String    @default("STUDENT") // Admin, Program_Manager, etc.
  accountStatus String    @default("ACTIVE") @map("account_status")
  inviteToken   String?   @unique @map("invite_token")
  inviteExpires DateTime? @map("invite_expires_at")
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  managerId    String? @map("manager_id")
  manager      User?   @relation("ManagedStaff", fields: [managerId], references: [id], onDelete: SetNull)
  managedStaff User[]  @relation("ManagedStaff")

  instructorPathwayId String?  @map("instructor_pathway_id")
  instructorPathway   Pathway? @relation("InstructorPathway", fields: [instructorPathwayId], references: [id], onDelete: SetNull)

  studentProfile           StudentProfile?
  classesTaught            ClassModel[]       @relation("InstructorClasses")
  assignedStudents         StudentProfile[]   @relation("CoachStudents")
  pmStudents               StudentProfile[]   @relation("PMStudents")
  managedCommunities       Community[]        @relation("PMCommunities")
  weeklyReports            WeeklyReport[]
  coachFeedbacks           CoachFeedback[]
  targetedQuestionsCreated TargetedQuestion[] @relation("CreatedByStaff")
  targetedAnswers          TargetedAnswer[]
  alerts                   Alert[]
  notifications            Notification[]
  auditLogs                AuditLog[]         @relation("AuditActor")
  conductEntriesAuthored   ConductEntry[]     @relation("ConductEntryAuthor")
  conductEntriesReviewed   ConductEntry[]     @relation("ConductEntryReviewer")
  conductEntriesReceived   ConductEntry[]     @relation("ConductEntryStudent")

  // Student engagement domain
  dailyCheckIns          DailyCheckIn[]       @relation("StudentCheckIns")
  weeklyGoals            WeeklyGoal[]         @relation("StudentWeeklyGoals")
  studentTemplates       StudentTemplate[]
  classChangeRequests    ClassChangeRequest[] @relation("StudentClassRequests")
  classRequestsDecided   ClassChangeRequest[] @relation("ClassRequestDecidedBy")
  coachingGoalsAsStudent CoachingGoal[]       @relation("CoachingGoalsStudent")
  coachingGoalsAsCoach   CoachingGoal[]       @relation("CoachingGoalsCoach")
  annotationsAuthored    Annotation[]         @relation("AnnotationAuthor")

  // Classroom staffing
  classStaffMemberships ClassStaffMembership[]

  // Chat
  chatMemberships  ChatChannelMember[]
  sentChatMessages ChatMessage[]       @relation("SentChatMessages")

  @@map("users")
}

model ConductEntry {
  id         String    @id @default(cuid())
  studentId  String    @map("student_id")
  authorId   String    @map("author_id")
  reviewerId String?   @map("reviewer_id")
  type       String // INFRACTION | CONVERSATION
  points     Int       @default(0)
  summary    String
  followUp   String    @map("follow_up")
  status     String    @default("PENDING") // PENDING | APPROVED | CLEARED
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  student  User  @relation("ConductEntryStudent", fields: [studentId], references: [id], onDelete: Cascade)
  author   User  @relation("ConductEntryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ConductEntryReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([status])
  @@map("conduct_entries")
}

model Community {
  id               String   @id @default(cuid())
  name             String
  description      String?
  programManagerId String?  @map("program_manager_id")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  programManager  User?            @relation("PMCommunities", fields: [programManagerId], references: [id], onDelete: SetNull)
  studentProfiles StudentProfile[]

  @@map("communities")
}

model Pathway {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  classes         ClassModel[]
  studentProfiles StudentProfile[]
  instructors     User[]           @relation("InstructorPathway")
  reportCycles    ReportCycle[]

  @@map("pathways")
}

model ClassModel {
  id           String   @id @default(cuid())
  name         String
  instructorId String?  @map("instructor_id")
  schedule     String?
  pathwayId    String   @map("pathway_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  instructor              User?                    @relation("InstructorClasses", fields: [instructorId], references: [id], onDelete: SetNull)
  pathway                 Pathway                  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  classRatings            ClassRating[]
  studentClassEnrollments StudentClassEnrollment[]
  staffMemberships        ClassStaffMembership[]
  changeRequests          ClassChangeRequest[]     @relation("ClassRequests")

  @@map("classes")
}

model StudentProfile {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  coachId          String?  @map("coach_id")
  programManagerId String?  @map("program_manager_id")
  communityId      String?  @map("community_id")
  pathwayId        String?  @map("pathway_id")
  phone            String?
  bio              String?
  accentColor      String   @default("#FF7A00") @map("accent_color")
  createdAt        DateTime @default(now()) @map("created_at")

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach            User?                    @relation("CoachStudents", fields: [coachId], references: [id], onDelete: SetNull)
  programManager   User?                    @relation("PMStudents", fields: [programManagerId], references: [id], onDelete: SetNull)
  community        Community?               @relation(fields: [communityId], references: [id], onDelete: SetNull)
  pathway          Pathway?                 @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  classEnrollments StudentClassEnrollment[]

  @@map("student_profiles")
}

model StudentClassEnrollment {
  id               String   @id @default(cuid())
  studentProfileId String   @map("student_profile_id")
  classId          String   @map("class_id")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classModel     ClassModel     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, classId])
  @@map("student_class_enrollments")
}

model ReportCycle {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  status    String   @default("OPEN")
  pathwayId String?  @map("pathway_id")
  createdAt DateTime @default(now()) @map("created_at")

  pathway           Pathway?           @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  weeklyReports     WeeklyReport[]
  targetedQuestions TargetedQuestion[]
  weeklyGoals       WeeklyGoal[]

  @@map("report_cycles")
}

model WeeklyReport {
  id          String    @id @default(cuid())
  studentId   String    @map("student_id")
  cycleId     String    @map("cycle_id")
  status      String    @default("DRAFT")
  submittedAt DateTime? @map("submitted_at")

  energy     Int? @default(5)
  mood       Int? @default(5)
  attendance Int? @default(100)
  confidence Int? @default(5)

  weeklyTopic       String? @map("weekly_topic")
  highlights        String?
  academicProgress  String? @map("academic_progress")
  classExperience   String? @map("class_experience")
  instructorSupport String? @map("instructor_support")
  events            String?
  upcomingEvents    String? @map("upcoming_events")
  challengesText    String? @map("challenges_text")
  challengesTags    String  @default("[]") @map("challenges_tags")
  supportNeeded     String? @map("support_needed")
  needsSupport      Boolean @default(false) @map("needs_support")
  reflection        String?
  goals             String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student         User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cycle           ReportCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  classRatings    ClassRating[]
  coachFeedback   CoachFeedback[]
  targetedAnswers TargetedAnswer[]
  annotations     Annotation[]
  weeklyGoals     WeeklyGoal[]

  @@unique([studentId, cycleId])
  @@index([studentId])
  @@index([cycleId])
  @@map("weekly_reports")
}

model ClassRating {
  id       String  @id @default(cuid())
  reportId String  @map("report_id")
  classId  String  @map("class_id")
  rating   String  @default("MEETING")
  comment  String?

  report     WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  classModel ClassModel   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([reportId, classId])
  @@map("class_ratings")
}

model CoachFeedback {
  id        String   @id @default(cuid())
  reportId  String   @map("report_id")
  coachId   String   @map("coach_id")
  feedback  String
  createdAt DateTime @default(now()) @map("created_at")

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  coach  User         @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_feedbacks")
}

model TargetedQuestion {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  creatorId String?  @map("creator_id")
  question  String
  isActive  Boolean  @default(true) @map("is_active")
  cycleId   String?  @map("cycle_id")
  createdAt DateTime @default(now()) @map("created_at")

  creator User?            @relation("CreatedByStaff", fields: [creatorId], references: [id], onDelete: SetNull)
  cycle   ReportCycle?     @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  answers TargetedAnswer[]

  @@map("targeted_questions")
}

model TargetedAnswer {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  reportId   String   @map("report_id")
  studentId  String   @map("student_id")
  answer     String
  createdAt  DateTime @default(now()) @map("created_at")

  question TargetedQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  report   WeeklyReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  student  User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([questionId, reportId])
  @@map("targeted_answers")
}

model Alert {
  id          String    @id @default(cuid())
  studentId   String    @map("student_id")
  type        String    @default("GENERAL")
  severity    String    @default("MEDIUM")
  description String
  resolved    Boolean   @default(false)
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([resolved])
  @@map("alerts")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  @map("actor_id")
  actorRole   String?  @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSettings {
  id                   String   @id @default("singleton")
  organizationName     String   @default("KSP Dominion Group") @map("organization_name")
  productName          String   @default("EchoTrack") @map("product_name")
  primaryColor         String   @default("#FF7A00") @map("primary_color")
  weeklyDueDay         Int      @default(5) @map("weekly_due_day") // 0=Sun … 5=Fri
  weeklyDueHour        Int      @default(17) @map("weekly_due_hour")
  autoCloseCycles      Boolean  @default(false) @map("auto_close_cycles")
  alertThresholdEnergy Int      @default(3) @map("alert_threshold_energy")
  alertThresholdMood   Int      @default(3) @map("alert_threshold_mood")
  alertThresholdAttend Int      @default(70) @map("alert_threshold_attend")
  alertThresholdConf   Int      @default(3) @map("alert_threshold_conf")
  outlookEnabled       Boolean  @default(false) @map("outlook_enabled")
  brightspaceEnabled   Boolean  @default(false) @map("brightspace_enabled")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ════════════════════════════════════════════════════════════════════════════
// STUDENT ENGAGEMENT DOMAIN
// Ported from the AI Studio export. Every model here is additive: no existing
// table, column or relation is modified.
// ════════════════════════════════════════════════════════════════════════════

model DailyCheckIn {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  moodEmoji   String   @map("mood_emoji")
  moodLabel   String?  @map("mood_label")
  energyLevel Int      @default(5) @map("energy_level")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  student User @relation("StudentCheckIns", fields: [studentId], references: [id], onDelete: Cascade)

  /// Reads are always "this student's most recent check-ins" — the composite
  /// index serves that ordering directly instead of sorting a student scan.
  @@index([studentId, createdAt])
  @@map("daily_check_ins")
}

model WeeklyGoal {
  id          String   @id @default(cuid())
  studentId   String   @map("student_id")
  cycleId     String?  @map("cycle_id")
  reportId    String?  @map("report_id")
  category    String   @default("ACADEMIC") // ACADEMIC | PERSONAL | CAREER
  title       String
  description String?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | NOT_COMPLETED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  student User          @relation("StudentWeeklyGoals", fields: [studentId], references: [id], onDelete: Cascade)
  cycle   ReportCycle?  @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  report  WeeklyReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([cycleId])
  @@index([reportId])
  @@map("weekly_goals")
}

model StudentTemplate {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  title     String
  type      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_templates")
}

model CoachingGoal {
  id          String    @id @default(cuid())
  studentId   String    @map("student_id")
  coachId     String    @map("coach_id")
  title       String
  description String?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  deadline    DateTime?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  student User @relation("CoachingGoalsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  coach   User @relation("CoachingGoalsCoach", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([coachId])
  @@map("coaching_goals")
}

model Annotation {
  id        String   @id @default(cuid())
  reportId  String   @map("report_id")
  authorId  String?  @map("author_id")
  section   String
  note      String
  createdAt DateTime @default(now()) @map("created_at")

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// The AI Studio model had no author. Internal staff notes are attributable by
  /// policy, so authorship is recorded here; nullable so the column can be added
  /// without a backfill.
  author User?        @relation("AnnotationAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("annotations")
}

model ClassChangeRequest {
  id           String    @id @default(cuid())
  studentId    String    @map("student_id")
  classId      String    @map("class_id")
  action       String // ADD | DROP
  status       String    @default("PENDING") // PENDING | APPROVED | DENIED
  reason       String?
  decidedById  String?   @map("decided_by_id")
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  student    User       @relation("StudentClassRequests", fields: [studentId], references: [id], onDelete: Cascade)
  classModel ClassModel @relation("ClassRequests", fields: [classId], references: [id], onDelete: Cascade)
  decidedBy  User?      @relation("ClassRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([classId])
  @@index([status])
  @@map("class_change_requests")
}

// ════════════════════════════════════════════════════════════════════════════
// CLASSROOM STAFFING
// The authorization anchor for instructor access: membership, not role claim.
// ════════════════════════════════════════════════════════════════════════════

model ClassStaffMembership {
  id          String    @id @default(cuid())
  classId     String    @map("class_id")
  userId      String    @map("user_id")
  staffRole   String    @default("PRIMARY_INSTRUCTOR") @map("staff_role")
  status      String    @default("ACTIVE") // ACTIVE | REMOVED
  isPrimary   Boolean   @default(false) @map("is_primary")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  removedAt   DateTime? @map("removed_at")

  classModel ClassModel @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, classId, staffRole])
  @@index([classId, status])
  @@index([userId, status])
  @@map("class_staff_memberships")
}

// ════════════════════════════════════════════════════════════════════════════
// CHAT
// ChatChannelMember has no counterpart in the AI Studio export, where channel
// access was decided by an `isPrivate` flag alone. The brief requires
// "channel membership obrigatório" — membership is modelled explicitly so a
// read can be authorized against a row rather than a boolean.
// ════════════════════════════════════════════════════════════════════════════

model ChatChannel {
  id          String   @id @default(cuid())
  name        String   @unique
  topic       String?
  isPrivate   Boolean  @default(false) @map("is_private")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members  ChatChannelMember[]
  messages ChatMessage[]

  @@map("chat_channels")
}

model ChatChannelMember {
  id         String    @id @default(cuid())
  channelId  String    @map("channel_id")
  userId     String    @map("user_id")
  role       String    @default("MEMBER") // MEMBER | MODERATOR
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastReadAt DateTime? @map("last_read_at")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("chat_channel_members")
}

model ChatMessage {
  id        String    @id @default(cuid())
  channelId String    @map("channel_id")
  senderId  String    @map("sender_id")
  content   String
  reactions String?
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User        @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  /// Paginating a channel is always "newest first within this channel".
  @@index([channelId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

// ════════════════════════════════════════════════════════════════════════════
// NOTIFICATION DISPATCH
// Deduplication ledger for transactional email. `dedupeKey` is the idempotency
// guarantee: a reminder for (user, event, period) can only be sent once, so a
// cron retry or a double invocation cannot re-send.
// ════════════════════════════════════════════════════════════════════════════

model NotificationDispatch {
  id                String    @id @default(cuid())
  dedupeKey         String    @unique @map("dedupe_key")
  eventType         String    @map("event_type")
  channel           String    @default("EMAIL")
  recipientId       String?   @map("recipient_id")
  recipientEmail    String    @map("recipient_email")
  status            String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
  providerMessageId String?   @map("provider_message_id")
  error             String?
  attempts          Int       @default(0)
  payload           String?
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([eventType, status])
  @@index([recipientId])
  @@map("notification_dispatches")
}
