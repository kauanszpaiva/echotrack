# ─────────────────────────────────────────────────────────────
# Database — Supabase Postgres
# Get these from: Supabase Dashboard → Project → Connect → ORMs (Prisma)
# Prisma uses these URLs for application data; Supabase Auth uses the public
# browser configuration below.
# ─────────────────────────────────────────────────────────────

# Browser authentication — Project Settings → API.
# These are public client values. Never expose SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-side Supabase (unified auth). The backend validates Supabase access
# tokens and provisions users with these. SERVICE_ROLE key is a SECRET — never
# prefix it with VITE_ and never expose it to the browser.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (session mode, port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────

# DEPRECATED — authentication is unified on Supabase Auth. JWT_SECRET is no
# longer used to authenticate requests and can be omitted.
# JWT_SECRET="REPLACE_WITH_RANDOM_HEX_64"

# Comma-separated browser origins allowed to call the API with credentials.
# In production set this to your Vercel domain, e.g. https://echotrack.vercel.app
CORS_ORIGINS="http://localhost:3000"

# Cookie settings. Use COOKIE_SAMESITE="none" only when embedding in a third-party iframe over HTTPS.
COOKIE_SAMESITE="lax"

# Environment
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────
# Firebase — social login (Google / Microsoft / Apple)
# Only the server needs the service account; the web keys live in
# firebase-applet-config.json (public by design).
# ─────────────────────────────────────────────────────────────

# Paste the full service account JSON as a single line (never commit the file).
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_APPLICATION_CREDENTIALS="/secure/path/firebase-service-account.json"

# Optional local seed admin (kauan@kspdominion.group).
# Set this password to create the admin login; leave unset to skip seeding it.
# ─────────────────────────────────────────────────────────────
# Optional local seed admin. Leave unset to skip creating a default admin.
# ─────────────────────────────────────────────────────────────
# DEV_ADMIN_EMAILS="admin@kspdominion.group"
# DEV_ADMIN_PASSWORD="generate-a-strong-local-password"
