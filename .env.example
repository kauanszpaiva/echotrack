# ─────────────────────────────────────────────────────────────
# Database — Supabase Postgres
# Get these from: Supabase Dashboard → Project → Connect → ORMs (Prisma)
# Prisma uses these URLs for application data; Supabase Auth uses the public
# browser configuration below.
# ─────────────────────────────────────────────────────────────

# Social sign-in (Google / Microsoft / Apple) is brokered through Supabase Auth.
# These are public client values. Never expose SUPABASE_SERVICE_ROLE_KEY here.
# Optional: email/password login does not use them. Leave them unset and only the
# social buttons are disabled.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Same two values for the API, which verifies social tokens before issuing an
# EchoTrack session. Falls back to the VITE_ values above when unset.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key-here"

# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (session mode, port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET="REPLACE_WITH_RANDOM_HEX_64"

# Comma-separated browser origins allowed to call the API with credentials.
# In production set this to your Vercel domain, e.g. https://echotrack.vercel.app
CORS_ORIGINS="http://localhost:3000"

# Cookie settings. Use COOKIE_SAMESITE="none" only when embedding in a third-party iframe over HTTPS.
COOKIE_SAMESITE="lax"

# Environment
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────
# Firebase — legacy social login path (POST /api/auth/oauth).
# Not used by the current frontend, which brokers social sign-in through
# Supabase. Only needed if you re-enable the Firebase client.
# ─────────────────────────────────────────────────────────────

# Paste the full service account JSON as a single line (never commit the file).
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_APPLICATION_CREDENTIALS="/secure/path/firebase-service-account.json"

# ─────────────────────────────────────────────────────────────
# First admin — `npm run db:bootstrap-admin` (any environment, idempotent).
# Passed on the command line or set here; never committed with a real password.
# ─────────────────────────────────────────────────────────────
# ADMIN_EMAIL="admin@kspdominion.group"
# ADMIN_NAME="Admin Name"
# ADMIN_PASSWORD="generate-a-strong-password"

# Optional local dev seed (`npm run db:seed`, development only).
# DEV_ADMIN_PASSWORD="generate-a-strong-local-password"
