# Database (SQLite path is relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET="REPLACE_WITH_RANDOM_HEX_64"

# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGINS="http://localhost:3000"

# Cookie settings. Use COOKIE_SAMESITE="none" only when embedding in a third-party iframe over HTTPS.
COOKIE_SAMESITE="lax"

# Environment
NODE_ENV="development"

# Firebase admin. Prefer one of these, never commit service account JSON files.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_APPLICATION_CREDENTIALS="C:/secure/path/firebase-service-account.json"

# Optional local seed admins. Leave unset to avoid creating default admin credentials.
# Shared password applied to every seeded admin below.
# DEV_ADMIN_PASSWORD="generate-a-strong-local-password"
#
# Option A — email-only. Display names are resolved automatically for known
# KSP admins (Kauan, Kayla, Karla); others get a name derived from the email.
# DEV_ADMIN_EMAILS="kauan@example.com,kayla@example.com,karla@example.com"
#
# Option B — explicit "Name:email" pairs (takes priority over DEV_ADMIN_EMAILS).
# DEV_ADMIN_USERS="Kauan Paiva:kauan@example.com,Kayla Paiva:kayla@example.com,Karla Paiva:karla@example.com"
