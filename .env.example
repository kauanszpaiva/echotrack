# EchoTrack environment variables.
#
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# Rule of thumb: only variables prefixed with VITE_ reach the browser — anything
# secret must NOT have that prefix.

# ─────────────────────────────────────────────────────────────
# SERVER — Database (Supabase Postgres, accessed via Prisma)
# Supabase Dashboard → Project → Connect → ORMs (Prisma).
# Supabase is the application database only; authentication is Clerk's job.
# ─────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (session mode, port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# SERVER — Auth (Clerk). Clerk Dashboard → API keys.
# ─────────────────────────────────────────────────────────────

# SECRET. Never prefix with VITE_, never expose to the browser.
CLERK_SECRET_KEY="sk_test_your-secret-key-here"

# Read by clerkMiddleware() server-side (same value as the browser key).
CLERK_PUBLISHABLE_KEY="pk_test_your-publishable-key-here"

# ─────────────────────────────────────────────────────────────
# SERVER — HTTP
# ─────────────────────────────────────────────────────────────

# Comma-separated allowlist of browser origins that may call the API with
# credentials. Exact origins only — no wildcards. In production set this to your
# real domain(s), e.g. https://echotrack.vercel.app. The deployment's own Vercel
# URLs (VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL, injected by Vercel) are
# always allowed and don't need listing here.
CORS_ORIGINS="http://localhost:3000"

NODE_ENV="development"

# ─────────────────────────────────────────────────────────────
# SERVER — Transactional email (Resend). Optional.
# If RESEND_API_KEY or EMAIL_FROM is unset, email degrades to a no-op: every
# dispatch is recorded as SKIPPED and no user-facing action ever fails because
# of it. Set all four to actually deliver mail.
# ─────────────────────────────────────────────────────────────

# SECRET. Resend Dashboard → API Keys.
# RESEND_API_KEY="re_your-api-key-here"

# Verified sender, e.g. "EchoTrack <no-reply@yourdomain.com>".
# EMAIL_FROM="EchoTrack <no-reply@example.com>"

# Optional Reply-To for transactional mail.
# EMAIL_REPLY_TO="support@example.com"

# Absolute base URL used to build links inside emails. Without it, emails still
# send but carry no call-to-action button.
# APP_BASE_URL="https://echotrack.vercel.app"

# ─────────────────────────────────────────────────────────────
# SERVER — Scheduled jobs (Vercel Cron)
# Shared secret protecting /api/cron/*. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Unset ⇒ the endpoint returns 503.
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
# CRON_SECRET="generate-a-long-random-value"

# ─────────────────────────────────────────────────────────────
# BROWSER — public values only (VITE_ prefix = shipped in the JS bundle)
# ─────────────────────────────────────────────────────────────

# Clerk publishable key. Public by design; this is the only Clerk key the
# browser needs.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your-publishable-key-here"

# Optional. Social sign-in buttons to render, comma-separated: google, microsoft,
# apple. Defaults to "google". Only list providers you have actually enabled in
# the Clerk dashboard, otherwise the button leads to an error.
# VITE_OAUTH_PROVIDERS="google"

# ─────────────────────────────────────────────────────────────
# Optional — one-off local seeding (`npm run db:seed`)
# Creates the first admin in Clerk + Postgres. Leave unset to skip.
# ─────────────────────────────────────────────────────────────
# DEV_ADMIN_PASSWORD="generate-a-strong-local-password"

# Optional — seeds one login per role (Dev, Program Manager, Coach, PSM,
# Instructor, Student, Intern) so every dashboard can be signed into during
# setup and testing. All share this password. Leave unset in production.
# DEV_SEED_PASSWORD="generate-a-strong-local-password"
