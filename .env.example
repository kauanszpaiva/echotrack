# ─────────────────────────────────────────────────────────────
# Database — Supabase Postgres
# Get these from: Supabase Dashboard → Project → Connect → ORMs (Prisma)
# EchoTrack validates email/password against the public `users` table through
# Prisma (JWT + bcrypt). It does NOT use Supabase Auth (`auth.users`).
# ─────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (session mode, port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET="REPLACE_WITH_RANDOM_HEX_64"

# Comma-separated browser origins allowed to call the API with credentials.
# In production set this to your Vercel domain, e.g. https://echotrack.vercel.app
CORS_ORIGINS="http://localhost:3000"

# Cookie settings. Use COOKIE_SAMESITE="none" only when embedding in a third-party iframe over HTTPS.
COOKIE_SAMESITE="lax"

# Environment
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────
# Admin seed (used only by `npm run db:seed`)
# The admin password is NEVER hardcoded. Set it here to create/refresh the
# admin login, then run `npm run db:seed` once. Leave unset to skip the admin.
# ─────────────────────────────────────────────────────────────
# DEV_ADMIN_EMAIL="kauan@kspdominion.group"
# DEV_ADMIN_PASSWORD="generate-a-strong-password"
