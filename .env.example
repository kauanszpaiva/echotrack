# ─────────────────────────────────────────────────────────────
# Database — Supabase Postgres (accessed via Prisma)
# Get these from: Supabase Dashboard → Project → Connect → ORMs (Prisma).
# Supabase is the application database; authentication is handled by Clerk.
# ─────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements.
DATABASE_URL="postgresql://postgres.bqhlcmcjpvfinatoaraz:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (session mode, port 5432) — used by `prisma migrate`.
DIRECT_URL="postgresql://postgres.bqhlcmcjpvfinatoaraz:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Auth — Clerk
# Get these from: Clerk Dashboard → API keys (app app_3Hma00OGmfOMnFAge9f9gTunNpP).
# ─────────────────────────────────────────────────────────────

# Publishable key — public, safe for the browser. Vite requires the VITE_ prefix.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your-publishable-key-here"

# Server-side keys. CLERK_SECRET_KEY is a SECRET — never prefix it with VITE_ and
# never expose it to the browser. clerkMiddleware() reads both from env.
CLERK_PUBLISHABLE_KEY="pk_test_your-publishable-key-here"
CLERK_SECRET_KEY="sk_test_your-secret-key-here"

# DEPRECATED — no longer used to authenticate requests and can be omitted.
# JWT_SECRET="REPLACE_WITH_RANDOM_HEX_64"

# Comma-separated browser origins allowed to call the API with credentials.
# In production set this to your Vercel domain, e.g. https://echotrack.vercel.app
CORS_ORIGINS="http://localhost:3000"

# Cookie settings. Use COOKIE_SAMESITE="none" only when embedding in a third-party iframe over HTTPS.
COOKIE_SAMESITE="lax"

# Environment
NODE_ENV="development"

# Optional local seed admin (kauan@kspdominion.group).
# Set this password to create the admin login; leave unset to skip seeding it.
# ─────────────────────────────────────────────────────────────
# Optional local seed admin. Leave unset to skip creating a default admin.
# ─────────────────────────────────────────────────────────────
# DEV_ADMIN_EMAILS="admin@kspdominion.group"
# DEV_ADMIN_PASSWORD="generate-a-strong-local-password"
